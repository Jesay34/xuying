# Host-side settings used by docker-compose.yml.
# Copy to .env and change only what you need. Never commit the real .env file.

TZ=Asia/Shanghai
XUYING_PORT=3434
XUYING_BIND_IP=0.0.0.0

# Persistent host directories. raw/ and library/ live under the same media mount
# so Xuying can create hard links without copying media.
XUYING_MEDIA_DIR=./data/media
XUYING_CONFIG_DIR=./data/config

# Optional image/container names.
XUYING_IMAGE=xuying-local:1.0.0-alpha.59
XUYING_CONTAINER_NAME=xuying

# Optional mirrors for networks where Docker Hub / PyPI are slow.
# PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
